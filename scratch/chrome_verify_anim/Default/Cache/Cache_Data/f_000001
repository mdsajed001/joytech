  50% {
    transform: translate3d(-50%, 50%, 0);
  }
}
@keyframes search-bubble-b {
  0%, 100% {
    transform: translate3d(0, 0, 0);
  }
  50% {
    transform: translate3d(50%, -50%, 0);
  }
}
@media (prefers-reduced-motion: reduce) {
