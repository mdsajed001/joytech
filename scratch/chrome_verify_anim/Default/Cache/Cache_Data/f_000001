  content: '';
  position: absolute;
  top: -35%;
  left: -35%;
  width: 170%;
  height: 170%;
  background-image: radial-gradient(circle at 75% 25%, rgba(255, 255, 255, 0.24) 0%, rgba(255, 255, 255, 0) 48%);
