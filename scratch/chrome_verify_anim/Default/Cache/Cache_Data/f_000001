  z-index: 1;
  will-change: transform;
  animation: search-bubble-a 10s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}
.cta-search-animated::after {
  content: '';
  position: absolute;
  top: -35%;
  left: -35%;
  width: 170%;
  height: 170%;
  background-image: radial-gradient(circle at 25% 75%, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0) 42%);
  pointer-events: none;
  z-index: 1;
  will-change: transform;
  animation: search-bubble-b 10s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
}
@keyframes search-bubble-a {
  0%, 100% {
    transform: translate3d(0, 0, 0);
